# Your OpenRouter API key — used to call Jev via the Decisions API.
# Get one at https://openrouter.ai/settings/keys
# NEVER commit the real value. This file is safe to commit; .env is not.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Port the Express server listens on.
# Cloudways sets PORT automatically — leave this as 3000 for local dev.
PORT=3000
